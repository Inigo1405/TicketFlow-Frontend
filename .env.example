# ──────────────────────────────────────────────────────────────────────────────
# TicketFlow Frontend — variables de entorno
# Copia este archivo a .env.local para desarrollo local.
# En Vercel, define estas variables en Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

#Base de datos (PostgreSQL)
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow1234
POSTGRES_DB=ticketflow_db

#Redis
REDIS_URL=redis://localhost:6379

#RabbitMQ
RABBIT_USER=ticketflow
RABBITMQ_PASSWORD=rabbit1234
RABBITMQ_URL=amqp://ticketflow:rabbit1234@localhost:5672

#JWT
JWT_SECRET=cambia_este_valor_en_produccion
JWT_EXPIRES_IN =7d

# URL base del backend (sin trailing slash)
# Producción: la URL pública de tu API, ej: https://api.tudominio.com/api
# Desarrollo local contra API real: http://localhost:3000/api
VITE_API_BASE_URL=https://api.tudominio.com/api
# Modo mock — usa el adaptador de datos en memoria en lugar de la API real.
# Poner en false (o dejar sin definir) en producción.
VITE_MOCK_MODE=false

# ──────────────────────────────────────────────────────────────────────────────
# Variables solo necesarias cuando VITE_MOCK_MODE=true (desarrollo local)
# ──────────────────────────────────────────────────────────────────────────────
VITE_DEV_EMAIL=demo@ticketflow.com
VITE_DEV_PASSWORD=demo1234
VITE_DEV_EMAIL2=carlos@ticketflow.com
VITE_DEV_PASSWORD2=agente1234
VITE_DEV_EMAIL3=cliente@empresa.com
VITE_DEV_PASSWORD3=cliente1234
